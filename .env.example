# Copy to .env and supply your own values. Never commit real credentials.
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Public identifiers used by browser integrations (not secrets).
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_THEAUDIODB_API_KEY=
NEXT_PUBLIC_SITE_URL=

# Supabase public browser credentials (anon/publishable key only; never service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. PKCE does not use this secret.
SPOTIFY_CLIENT_SECRET=
